# ============================================================
# 美食獵人執照 — 環境變數範本
# 複製為 .env 並填入真實值，.env 已加入 .gitignore
# ============================================================

# -- Supabase --
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # 後端專用，絕不暴露給前端
SUPABASE_ANON_KEY=eyJ...           # 備用（目前後端走 service_role）

# -- Google Places API --
GOOGLE_PLACES_API_KEY=AIza...

# -- LINE Login --
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=https://<your-domain>/callback

# -- Flask --
FLASK_SECRET_KEY=<random-hex-32>
FLASK_ENV=development              # production on Render
